# ==============================================================================
# ImageLink Generator - Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit .env containing real production tokens or secrets to version control.
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV="production"

# Server Port (defaults to 3000)
PORT="3000"

# PUBLIC_BASE_URL: The canonical public HTTPS URL where this application is hosted.
# Used for constructing public Image Links (e.g. https://your-domain.com/i/a8Kx29Lm),
# canonical meta tags, Open Graph social crawlers, and Telegram webhook registration.
PUBLIC_BASE_URL="https://your-domain.com"

# APP_URL: Platform-injected hosting URL (e.g. Cloud Run, Railway, Render)
# Falls back to PUBLIC_BASE_URL or request Host header if not specified.
APP_URL="https://your-domain.com"

# TELEGRAM_BOT_TOKEN: The HTTP API token obtained from @BotFather in Telegram.
# Required for Telegram bot commands (/start, /new, /links, /stats, /cancel) and webhook updates.
# If omitted, the web creator and simulator work normally without live Telegram connectivity.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE"

# ADMIN_SECRET: Strong secret key required to access the admin moderation console (/admin)
# Used to authenticate administrative actions (view stats, inspect links, disable/enable links).
ADMIN_SECRET="change_me_to_a_secure_random_string_32_chars"
